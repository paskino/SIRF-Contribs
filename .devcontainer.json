{
  "name": "SyneRBI SIRF Project 5",
  "dockerComposeFile": [
    "src/notebooks/AIRBI-MRI-recon/docker-compose.yml"
  ],
  "service": "sirf-mri-recon",
  "runServices": ["sirf-mri-recon"],
  "workspaceFolder": "/home/jovyan/work/SIRF-Contribs",
  "shutdownAction": "stopCompose",
  "containerUser": "1000:1000",
  "remoteUser": "1000",
  "overrideCommand": false,
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.vscode-github-actions",
        "ms-python.isort",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "ms-vscode.cmake-tools",
        "ms-vscode.cpptools",
        "tamasfe.even-better-toml",
        "twxs.cmake",
        "yzhang.markdown-all-in-one"
      ],
      "settings": {
        "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
        "C_Cpp.default.includePath": [
          "/opt/SIRF-SuperBuild/sources/**/include",
          "/opt/SIRF-SuperBuild/INSTALL/include",
          "/opt/SIRF-SuperBuild/INSTALL/include/*/"
        ],
        "cmake.automaticReconfigure": false,
        "cmake.buildDirectory": "${workspaceFolder}",
        "cmake.clearOutputBeforeBuild": false,
        "cmake.cmakePath": "/usr/local/bin/cmake",
        "cmake.configureOnEdit": false,
        "cmake.configureOnOpen": false,
        "cmake.deleteBuildDirOnCleanConfigure": false,
        "cmake.enableAutomaticKitScan": false,
        "cmake.generator": "Ninja",
        "cmake.ignoreKitEnv": true,
        "cmake.skipConfigureIfCachePresent": true,
        "python.defaultInterpreterPath": "/opt/conda/bin/python"
      }
    }
  },
  "forwardPorts": [8888, 9002],
  "portsAttributes": {
    "8888": {
      "label": "Jupyter",
      "requireLocalPort": true,
      "onAutoForward": "ignore"
    },
    "9002": {
      "label": "Gadgetron",
      "onAutoForward": "silent"
    }
  }
}
